# Filesystem root Atlas reads. Relative paths resolve from the project root.
# It must contain project subfolders; a project folder itself (e.g. data/new)
# yields no projects. Unset or empty means "data".
ATLAS_DATA_ROOT=data

# Vite loads .env.<mode> as well: development (npm run dev),
# staging (npm run dev:staging / build:staging), production (npm run build).
# Shell values override .env files.
